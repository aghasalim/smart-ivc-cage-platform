# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/ivc.db
JWT_SECRET=replace-with-a-strong-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Default seeded accounts (only used on first boot)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=change-me-please
DEFAULT_RESEARCHER_USER=researcher
DEFAULT_RESEARCHER_PASSWORD=change-me-please

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
# Raspberry Pi MJPEG streamer (USB cameras). 192.168.50.2 = direct LAN cable to Pi.
VITE_PI_STREAM_URL=http://192.168.50.2:8090

# --- Device simulator ---
SIM_BACKEND_URL=http://backend:8000
SIM_CAGE_IDS=cage-001,cage-002,cage-003
SIM_INTERVAL_SECONDS=5
SIM_API_TOKEN=

# --- General ---
ENV=development
LOG_LEVEL=INFO
