# Production build environment — read by Vite during `npm run build`.
# These are public URLs (the dashboard is served from them), not secrets, but the
# real file is gitignored so a fork never inherits someone else's deployment.
# Copy to `.env.production` and point at your own host.

VITE_API_URL=https://your-domain.example
VITE_WS_URL=wss://your-domain.example/ws
VITE_PI_STREAM_URL=https://cam.your-domain.example
