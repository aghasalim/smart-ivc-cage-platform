# Copy this file to .env (in the same directory) and fill in your API_KEY.
# The systemd unit reads .env via EnvironmentFile=.

# Required: backend API key. Create one at https://example.org → Settings → API Keys.
API_KEY=ivc_REPLACE_WITH_YOUR_KEY

# Optional overrides — uncomment to customise.
# CAMERA_URL=http://127.0.0.1:8090
# BACKEND_URL=https://example.org
# Model path. Defaults to Fine_Tuned.pt (fine-tuned mouse detector, 1 class
# "Mouse"); falls back to best.pt if absent.
# MODEL_PATH=/home/grazwis/pi-inference/Fine_Tuned.pt
# CONF_THRESH=0.40

# Inference resolution. 480 ≈ 70 ms/frame on Pi 5 NCNN. Drop to 320 for
# ~40 ms/frame if your mice fill at least ~5% of the frame. Bump to 640 if
# the model misses small/distant mice.
# YOLO_IMGSZ=480

# Use NCNN (Tencent's ARM-optimised engine). On first run, .pt is exported
# to NCNN automatically; subsequent runs use the cached NCNN directory.
# Set to 0 to force the slower torch backend.
# USE_NCNN=1

# LOOP_DELAY_S=0
